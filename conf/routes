
# Routes(routing engine)
# This file defines all application routes (Higher priority routes first)
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

#Now we connect the URLs to the controller methods.
GET     /students                   controllers.StudentController.getAllStudents()
GET     /students/:id               controllers.StudentController.getStudentById(id:Long)
POST    /students                   controllers.StudentController.createStudent(request:Request)
PUT     /students/:id               controllers.StudentController.updateStudent(id:Long,request:Request)
DELETE  /students/:id               controllers.StudentController.deleteStudent(id:Long)
